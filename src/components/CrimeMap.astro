---
// The home-page crime map. A pan-and-zoom map (MapLibre, with free
// OpenStreetMap streets from OpenFreeMap) of a year of police-reported
// incidents, plus a takeaways panel that rewrites itself for every
// filter. Views:
//   Hexagons      → H3 hexagons, colored by the main crime type (or by count)
//   Hot spots     → a smooth heat surface
//   Points        → incidents shown as dots, snapped to 150 m cells
//   Neighborhoods → Census block groups, counts or rates per 1,000
//
// Data: /data/crime-grid.json, /data/crime-bg.json, /data/places.json,
// built weekly by scripts/. Only aggregated counts are published.
interface Props { kcLink?: boolean }   // link to the Kansas City page (off when already on it)
const { kcLink = true } = Astro.props;
---
<section class="crime-map" id="map" aria-label="Kansas City crime map">
  <div class="cm-controls wrap">
    <div class="cm-row">
    <div class="seg" role="group" aria-label="Map view">
      <button type="button" data-mode="hex" aria-pressed="true">Hexagons</button>
      <button type="button" data-mode="heat" aria-pressed="false">Hot spots</button>
      <button type="button" data-mode="points" aria-pressed="false">Points</button>
      <button type="button" data-mode="bg" aria-pressed="false">Neighborhoods</button>
    </div>
    <div class="selects">
      <label class="sel"><span class="label">Time</span>
        <select id="cm-band" data-band><option value="-1">All day</option></select>
      </label>
      <label class="sel"><span class="label">Days</span>
        <select id="cm-days" data-days>
          <option value="-1">All week</option>
          <option value="0">Weekdays</option>
          <option value="1">Weekends</option>
        </select>
      </label>
      <label class="sel" data-color-wrap><span class="label">Color by</span>
        <select id="cm-color" data-color>
          <option value="type">Main crime type</option>
          <option value="count">Number of incidents</option>
        </select>
      </label>
      <label class="sel" data-measure-wrap hidden><span class="label">Show</span>
        <select id="cm-measure" data-measure>
          <option value="count">Count</option>
          <option value="rate">Per 1,000 residents</option>
        </select>
      </label>
    </div>
    </div>
    <div class="chips groups" role="group" aria-label="NIBRS Crime Against groups" data-groups></div>
    <div class="chips types" role="group" aria-label="NIBRS offense categories (also the map legend)" data-cats></div>
  </div>

  <div class="cm-body">
    <div class="cm-map-wrap">
      <div class="cm-map" data-map role="region" aria-label="Interactive map of Kansas City crime. The key findings are listed beside the map."></div>
      <p class="cm-key label" data-key></p>
      <div class="tk detail" data-detail hidden></div>
    </div>

    <aside class="cm-panel wrap" aria-live="polite" aria-label="What the map shows">
      <p class="label" data-title>Loading a year of Kansas City data…</p>

      <div class="tk">
        <p class="tk-big" data-share>–</p>
        <p class="tk-text" data-share-text></p>
      </div>

      <div class="tk">
        <p class="label">When it happens</p>
        <div class="bars" data-bars></div>
        <p class="tk-text" data-time-text></p>
      </div>

      <div class="tk">
        <p class="label">What happens</p>
        <div class="mix" data-mix></div>
        <p class="tk-text" data-mix-text></p>
      </div>

      <div class="tk">
        <p class="label">Busiest hexagons <span data-hot-note></span></p>
        <ol class="hot" data-hot></ol>
      </div>


      {kcLink && <p class="more-kc"><a href="/kansas-city/">Kansas City by the numbers: trends, peak hours, and neighborhood rankings →</a></p>}
      <p class="label src" data-src-line></p>
    </aside>
  </div>
</section>

<style>
  /* The map section always uses the light palette, even in dark mode. */
  .crime-map {
    --paper: #f5efe0; --paper-2: #ebe2cc; --ink: #1f2d48; --ink-2: #4c566a; --rule: #d9cfb6; --card: #fbf8f0;
    --hot: #b4371f; --hot-ink: #9a2f18;
    --ramp-1: #f3d98b; --ramp-2: #e39a36; --ramp-3: #c9452a; --ramp-4: #6e1d12;
    /* Crime types: Okabe–Ito, a palette built to stay distinct for colorblind readers */
    --cat-0: #d55e00;  /* Violent: vermillion */
    --cat-1: #0072b2;  /* Vehicle: blue */
    --cat-2: #cc79a7;  /* Burglary: reddish purple */
    --cat-3: #e69f00;  /* Theft: orange */
    --cat-4: #009e73;  /* Vandalism: bluish green */
    --cat-5: #56b4e9;  /* Drugs & weapons: sky blue */
    --cat-6: #c9b800;  /* Fraud: yellow (deepened to show on a light map) */
    --cat-7: #8a8f99;  /* Other: grey */
    color-scheme: light; color: var(--ink);
    border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); background: var(--card);
  }
  .cm-controls { display: grid; gap: 0.65rem; padding-block: 0.9rem; }
  .cm-row { display: flex; flex-wrap: wrap; gap: 0.6rem 1.25rem; align-items: center; justify-content: space-between; }
  .seg { display: inline-flex; flex-wrap: wrap; border: 1px solid var(--rule); border-radius: var(--radius); overflow: hidden; }
  .seg button { font: 500 var(--t-xs)/1 var(--mono); letter-spacing: 0.06em; text-transform: uppercase; padding: 0.55rem 0.7rem; background: var(--card); color: var(--ink-2); border: 0; cursor: pointer; }
  .seg button + button { border-left: 1px solid var(--rule); }
  .seg button[aria-pressed='true'] { background: var(--ink); color: var(--paper); }
  .chips { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .chips :global(button) {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font: 500 var(--t-xs)/1 var(--body); padding: 0.42rem 0.65rem; border-radius: 999px; cursor: pointer;
    border: 1px solid var(--rule); background: var(--card); color: var(--ink-2);
  }
  .chips :global(button) :global(i) { width: 0.7rem; height: 0.7rem; border-radius: 2px; background: var(--c); opacity: 0.3; }
  .chips :global(button[aria-pressed='true']) { color: var(--ink); border-color: var(--ink-2); }
  .chips :global(button[aria-pressed='true']) :global(i) { opacity: 1; }
  .groups :global(button.grp) { font-weight: 650; font-size: var(--t-sm); padding: 0.5rem 0.8rem; }
  .groups :global(.ct) { font: 400 var(--t-xs) var(--mono); color: var(--ink-2); margin-left: 0.15rem; }
  .types :global(button) { font-size: 0.72rem; padding: 0.36rem 0.58rem; }
  .selects { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; }
  .sel { display: inline-flex; align-items: center; gap: 0.4rem; }
  .sel select { font: 500 var(--t-xs)/1 var(--body); color: var(--ink); background: var(--card); border: 1px solid var(--rule); border-radius: var(--radius); padding: 0.38rem 0.4rem; }

  .cm-body { display: grid; grid-template-columns: minmax(0, 1fr); border-top: 1px solid var(--rule); }
  .cm-map-wrap { position: relative; min-width: 0; }
  .cm-map { height: clamp(26rem, 68vh, 46rem); width: 100%; background: var(--paper-2); }
  .cm-key { position: absolute; left: 0.6rem; top: 0.6rem; margin: 0; background: var(--card); padding: 0.4rem 0.55rem; border: 1px solid var(--rule); border-radius: var(--radius); text-transform: none; letter-spacing: 0.02em; max-width: calc(100% - 4rem); }

  /* Insights: always below the map, 4 → 2 → 1 cards as the screen narrows. */
  .cm-panel {
    display: grid; gap: 1rem 2rem; align-items: start;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16.5rem), 1fr));
    border-top: 1px solid var(--rule); padding-block: 1.4rem 1.6rem; min-width: 0;
  }
  .cm-panel > .label, .cm-panel > .src, .cm-panel > .more-kc { grid-column: 1 / -1; }
  .more-kc { font-weight: 600; }
  .tk { display: grid; gap: 0.45rem; align-content: start; min-width: 0; }
  .tk-big { font-family: var(--display); font-stretch: 112%; font-weight: 800; font-size: 2.3rem; line-height: 1; color: var(--hot-ink); font-variant-numeric: tabular-nums; }
  .tk-text { font-size: var(--t-sm); color: var(--ink-2); }
  .tk-text :global(strong) { color: var(--ink); }

  .bars { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.4rem; height: 6.2rem; }
  .bars :global(div) { display: flex; flex-direction: column; justify-content: flex-end; gap: 0.2rem; height: 100%; }
  .bars :global(b) { display: block; flex: none; background: var(--ink-2); opacity: 0.35; border-radius: 2px 2px 0 0; min-height: 2px; }
  .bars :global(div.peak b) { background: var(--hot); opacity: 1; }
  .bars :global(span) { font: 500 0.66rem/1.1 var(--mono); color: var(--ink-2); text-align: center; text-transform: uppercase; letter-spacing: 0.03em; }

  .mix { display: flex; height: 0.85rem; border-radius: 3px; overflow: hidden; background: var(--paper-2); }
  .mix :global(span) { background: var(--c); height: 100%; }
  /* Colored swatch beside each name; the text itself stays dark for contrast. */
  .tk-text :global(.mk) { display: inline-block; width: 0.6rem; height: 0.6rem; border-radius: 2px; background: var(--c); margin-right: 0.3rem; vertical-align: baseline; }

  .hot { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  .hot :global(button) {
    width: 100%; display: grid; grid-template-columns: 1.4rem minmax(0, 1fr) auto; gap: 0.5rem; align-items: baseline; text-align: left;
    font: 500 var(--t-sm)/1.3 var(--body); color: var(--ink); background: transparent; border: 0; border-bottom: 1px solid var(--rule); padding: 0.45rem 0; cursor: pointer;
  }
  .hot :global(button:hover) { color: var(--hot-ink); }
  .hot :global(.n) { font-family: var(--mono); font-size: var(--t-xs); color: var(--ink-2); font-variant-numeric: tabular-nums; }
  .hot :global(.rk) { font-family: var(--mono); font-size: var(--t-xs); color: var(--hot-ink); }
  .hot :global(.ty) { display: block; font-size: var(--t-xs); color: var(--ink-2); font-weight: 400; }

  .detail {
    position: absolute; left: 0.75rem; bottom: 2.4rem; z-index: 2; width: min(20rem, calc(100% - 1.5rem));
    background: var(--card); border: 1px solid var(--rule); border-radius: var(--radius);
    padding: 0.8rem 0.9rem; box-shadow: 0 6px 20px rgba(31, 45, 72, 0.15);
  }
  .detail :global(ul) { list-style: none; margin: 0.3rem 0 0; padding: 0; display: grid; gap: 0.25rem; font-size: var(--t-sm); }
  .detail :global(li) { display: flex; justify-content: space-between; gap: 1rem; }
  .detail :global(li i) { display: inline-block; width: 0.6rem; height: 0.6rem; border-radius: 2px; background: var(--c); margin-right: 0.35rem; }
  .detail :global(.close) { float: right; font: 500 var(--t-xs)/1 var(--mono); background: none; border: 0; color: var(--ink-2); cursor: pointer; text-transform: uppercase; }
  .src { text-transform: none; letter-spacing: 0.02em; font-size: 0.68rem; line-height: 1.5; }
  .src :global(a) { color: inherit; text-decoration: underline; }

  /* MapLibre controls in the site's palette. Credit links are underlined
     so they don't rely on color alone (WCAG link-in-text-block). */
  .cm-map :global(.maplibregl-ctrl-attrib a) { text-decoration: underline; color: #1f2d48; }
  .cm-map :global(.maplibregl-ctrl-group) { border-radius: var(--radius); }
  .cm-map :global(.maplibregl-popup-content) { font: 400 var(--t-sm)/1.4 var(--body); color: #1f2d48; }
</style>

<script>
  // The map code (MapLibre, H3) and its data load only when the map is
  // about to scroll into view: a dynamic import() keeps it out of the
  // page's first download.
  const mapSection = document.querySelector<HTMLElement>('.crime-map')!;
  let started = false;
  const start = () => {
    if (started) return;
    started = true;
    import('../scripts/crime-map').then((m) => m.startMap()).catch(() => {
      mapSection.querySelector('[data-title]')!.textContent = 'The map could not load. Try refreshing the page.';
    });
  };
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) { io.disconnect(); start(); }
    }, { rootMargin: '600px 0px' });
    io.observe(mapSection);
  } else start();
  // Arriving via the "Explore the map" link (#map) starts it right away.
  if (location.hash === '#map') start();
  addEventListener('hashchange', () => { if (location.hash === '#map') start(); });
</script>
