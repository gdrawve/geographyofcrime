---
// Signature element: the analyst's workflow on real city data.
//   Points        → incidents, as dots snapped to 150 m cells
//   Hexagons      → counts per hexagon (size is adjustable)
//   Hot spots     → a kernel density surface
//   Neighborhoods → counts or rates per Census block group
// Filters (offense, time of day, weekday/weekend) recalculate every
// view and the concentration statistic instantly in the browser.
//
// Data: public/data/crime-grid.json and crime-bg.json, built weekly by
// scripts/build_crime_grid.py. Only aggregated counts are published,
// never exact incident locations.
---
<figure class="cmap" data-src="/data/crime-grid.json" data-src-bg="/data/crime-bg.json" data-src-base="/data/basemap.json" aria-label="Interactive crime concentration map">
  <div class="bar">
    <p class="label" data-title>Loading data…</p>
    <div class="seg" role="group" aria-label="Map view">
      <button type="button" data-mode="points" aria-pressed="false">Points</button>
      <button type="button" data-mode="hex" aria-pressed="true">Hexagons</button>
      <button type="button" data-mode="kde" aria-pressed="false">Hot spots</button>
      <button type="button" data-mode="bg" aria-pressed="false">Neighborhoods</button>
    </div>
  </div>

  <div class="filters">
    <div class="fgroup" role="group" aria-label="Offense type" data-cats></div>
    <div class="frow">
      <label class="sel"><span class="label">Time</span>
        <select id="cmap-band" data-band><option value="-1">All day</option></select>
      </label>
      <label class="sel"><span class="label">Days</span>
        <select id="cmap-days" data-days>
          <option value="-1">All week</option>
          <option value="0">Weekdays</option>
          <option value="1">Weekends</option>
        </select>
      </label>
      <label class="sel" data-size-wrap><span class="label">Hexagon</span>
        <select id="cmap-size" data-size>
          <option value="300">300 m</option>
          <option value="600" selected>600 m</option>
          <option value="1000">1 km</option>
        </select>
      </label>
      <label class="sel" data-measure-wrap hidden><span class="label">Show</span>
        <select id="cmap-measure" data-measure>
          <option value="count">Count</option>
          <option value="rate">Per 1,000 residents</option>
        </select>
      </label>
    </div>
  </div>

  <div class="canvas-wrap">
    <canvas aria-hidden="true"></canvas>
    <p class="hover label" data-hover hidden></p>
  </div>

  <figcaption class="foot">
    <p class="stat"><strong data-share>–</strong> <span data-share-text>of active areas hold half of these incidents.</span></p>
    <p class="label src" data-src-line></p>
  </figcaption>
</figure>

<style>
  .cmap { margin: 0; min-width: 0; display: grid; border: 1px solid var(--rule); border-radius: var(--radius); background: var(--card); }
  .bar, .filters, .foot { padding: 0.7rem 0.9rem; }
  .bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem 1rem; border-bottom: 1px solid var(--rule); }
  .seg { display: inline-flex; flex-wrap: wrap; border: 1px solid var(--rule); border-radius: var(--radius); overflow: hidden; }
  .seg button {
    font: 500 var(--t-xs)/1 var(--mono); letter-spacing: 0.06em; text-transform: uppercase;
    padding: 0.5rem 0.65rem; background: transparent; color: var(--ink-2); border: 0; cursor: pointer;
  }
  .seg button + button { border-left: 1px solid var(--rule); }
  .seg button[aria-pressed='true'] { background: var(--ink); color: var(--paper); }

  .filters { display: grid; gap: 0.6rem; border-bottom: 1px solid var(--rule); }
  .fgroup { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .fgroup :global(button) {
    font: 500 var(--t-xs)/1 var(--body); padding: 0.4rem 0.6rem; border-radius: 999px; cursor: pointer;
    border: 1px solid var(--rule); background: transparent; color: var(--ink-2);
  }
  .fgroup :global(button[aria-pressed='true']) { background: var(--paper-2); color: var(--ink); border-color: var(--ink-2); }
  .fgroup :global(button[aria-pressed='true'])::before { content: '● '; color: var(--hot); }
  .frow { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; }
  .sel { display: inline-flex; align-items: center; gap: 0.4rem; }
  .sel select { font: 500 var(--t-xs)/1 var(--body); color: var(--ink); background: var(--card); border: 1px solid var(--rule); border-radius: var(--radius); padding: 0.35rem 0.4rem; }

  .canvas-wrap { position: relative; width: 100%; max-width: 100%; aspect-ratio: 4 / 3; }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: pan-y; }
  .hover { position: absolute; left: 0.6rem; bottom: 0.6rem; margin: 0; max-width: calc(100% - 1.2rem); background: var(--ink); color: var(--paper); padding: 0.35rem 0.5rem; border-radius: 2px; pointer-events: none; text-transform: none; letter-spacing: 0.02em; }

  .foot { display: grid; gap: 0.35rem; border-top: 1px solid var(--rule); }
  .stat { font-size: var(--t-sm); color: var(--ink-2); }
  .stat strong { font-family: var(--display); font-stretch: 112%; font-size: 1.35rem; color: var(--hot-ink); font-variant-numeric: tabular-nums; }
  .src { text-transform: none; letter-spacing: 0.02em; }
  .src :global(a) { color: inherit; }
</style>

<script>
  type Meta = {
    city: string; extent?: string; source: string; sourceUrl: string; start: string; end: string; updated: string;
    demo: boolean; total: number; cellMeters: number; cols: number; rows: number; bbox: number[];
    categories: string[]; bands: string[];
  };
  type BG = { id: string; pop: number | null; rings: number[][][]; counts: number[]; path?: Path2D; n?: number; v?: number | null };

  const fig = document.querySelector<HTMLElement>('.cmap')!;
  const canvas = fig.querySelector('canvas')!;
  const ctx = canvas.getContext('2d')!;
  const $ = <T extends Element>(s: string) => fig.querySelector<T>(s)!;

  // ── State ───────────────────────────────────────────────────
  let M: Meta, cells: number[][];
  let bgs: BG[] | null = null, bgMinPop = 200, bgSource = '';
  type Base = { attribution: string; river: number[][][]; motorway: number[][][]; trunk: number[][][]; primary: number[][][]; labels: { name: string; lon: number; lat: number; kind: string }[] };
  let base: Base | null = null;
  let mode: 'points' | 'hex' | 'kde' | 'bg' = 'hex';
  const state = { cats: new Set<number>(), band: -1, days: -1, hexM: 600, measure: 'count' as 'count' | 'rate' };
  let fine: Float32Array;              // filtered counts per 150 m cell
  let footprint: Uint8Array;           // 1 where any incident ever occurred
  let hexes: { q: number; r: number; n: number }[] = [];
  let total = 0;

  // ── Load ───────────────────────────────────────────────────
  fetch(fig.dataset.src!)
    .then((r) => { if (!r.ok) throw new Error(String(r.status)); return r.json(); })
    .then((d) => { M = d.meta; cells = d.cells; init(); })
    .catch(() => ($('[data-title]').textContent = 'Map data is unavailable right now.'));

  // Reference basemap (river, major roads, neighborhood names).
  fetch(fig.dataset.srcBase!).then((r) => (r.ok ? r.json() : null)).then((d) => { base = d; if (M) { sourceLine(); draw(); } }).catch(() => {});

  // Block groups load only when the Neighborhoods view is first opened.
  function loadBgs(): Promise<void> {
    if (bgs) return Promise.resolve();
    return fetch(fig.dataset.srcBg!)
      .then((r) => { if (!r.ok) throw new Error(); return r.json(); })
      .then((d) => { bgs = d.bgs; bgMinPop = d.meta.minPopForRate ?? 200; bgSource = d.meta.boundarySource ?? ''; })
      .catch(() => { bgs = []; });
  }

  // ── Slots: the same layout the Python script writes ────────
  // slot = (category × bands + band) × 2 + weekend
  const matches = (slot: number) => {
    const NB = M.bands.length, wk = slot % 2, band = Math.floor(slot / 2) % NB, cat = Math.floor(slot / 2 / NB);
    return state.cats.has(cat) && (state.band < 0 || band === state.band) && (state.days < 0 || wk === state.days);
  };
  const sumSlots = (arr: number[], from: number) => {
    let n = 0;
    for (let j = from; j < arr.length; j += 2) if (matches(arr[j])) n += arr[j + 1];
    return n;
  };

  function init() {
    M.categories.forEach((_, i) => state.cats.add(i));
    $('[data-title]').innerHTML = `<span class="hot">●</span> ${M.city}${M.demo ? ' (demo data)' : ''} · ${M.total.toLocaleString()} incidents`;

    const catBox = $('[data-cats]');
    M.categories.forEach((c, i) => {
      const b = document.createElement('button');
      b.type = 'button'; b.textContent = c; b.setAttribute('aria-pressed', 'true');
      b.addEventListener('click', () => {
        if (state.cats.has(i) && state.cats.size === 1) return; // keep at least one on
        state.cats.has(i) ? state.cats.delete(i) : state.cats.add(i);
        b.setAttribute('aria-pressed', String(state.cats.has(i)));
        recompute();
      });
      catBox.append(b);
    });
    const bandSel = $<HTMLSelectElement>('[data-band]');
    M.bands.forEach((b, i) => bandSel.add(new Option(b, String(i))));
    bandSel.addEventListener('change', () => { state.band = +bandSel.value; recompute(); });
    $<HTMLSelectElement>('[data-days]').addEventListener('change', (e) => { state.days = +(e.target as HTMLSelectElement).value; recompute(); });
    $<HTMLSelectElement>('[data-size]').addEventListener('change', (e) => { state.hexM = +(e.target as HTMLSelectElement).value; recompute(); });
    $<HTMLSelectElement>('[data-measure]').addEventListener('change', (e) => { state.measure = (e.target as HTMLSelectElement).value as any; recompute(); });

    // Match the canvas to the city's shape; cap tall cities at 36rem.
    const wrap = $<HTMLElement>('.canvas-wrap');
    wrap.style.aspectRatio = `${M.cols} / ${M.rows}`;
    if (M.rows > M.cols) { wrap.style.width = `min(100%, ${(36 * M.cols) / M.rows}rem)`; wrap.style.marginInline = 'auto'; }

    footprint = new Uint8Array(M.cols * M.rows);
    for (const c of cells) footprint[c[1] * M.cols + c[0]] = 1;
    sourceLine();
    recompute();
  }

  const fmt = (iso: string) => new Date(iso + 'T12:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  function sourceLine() {
    const range = `${fmt(M.start)} – ${fmt(M.end)}`;
    const bgNote = (mode === 'bg' && bgSource ? ` · Boundaries: ${bgSource}` : '') + (base ? ` · Basemap ${base.attribution}` : '');
    $('[data-src-line]').innerHTML = M.demo
      ? `Simulated incidents for preview · ${range}${bgNote}`
      : `${M.extent ? M.extent + ' · ' : ''}Source: <a href="${M.sourceUrl}" target="_blank" rel="noopener">${M.source}</a> · ${range} · Updated ${fmt(M.updated)} · Aggregated to ${M.cellMeters} m cells${bgNote}`;
  }

  // ── Hexagon math (pointy-top hexes, sizes in meters) ───────
  // A hexagon "width" of 600 m is the distance between flat sides.
  const SQ3 = Math.sqrt(3);
  function toHex(x: number, y: number, R: number) {
    const qf = ((SQ3 / 3) * x - y / 3) / R, rf = ((2 / 3) * y) / R, sf = -qf - rf;
    let q = Math.round(qf), r = Math.round(rf); const s = Math.round(sf);
    const dq = Math.abs(q - qf), dr = Math.abs(r - rf), ds = Math.abs(s - sf);
    if (dq > dr && dq > ds) q = -r - s; else if (dr > ds) r = -q - s;
    return [q, r];
  }
  const hexCenter = (q: number, r: number, R: number) => [R * SQ3 * (q + r / 2), R * 1.5 * r];

  // Share of active areas that together hold half the incidents.
  function concentration(values: number[], active: number) {
    if (!total || !active) return null;
    const sorted = [...values].sort((a, b) => b - a);
    let run = 0, need = 0;
    while (run < total / 2 && need < sorted.length) run += sorted[need++];
    return (need / active) * 100;
  }

  // ── Recompute everything the filters touch ─────────────────
  async function recompute() {
    $<HTMLElement>('[data-size-wrap]').hidden = mode === 'bg' || mode === 'points' || mode === 'kde';
    $<HTMLElement>('[data-measure-wrap]').hidden = mode !== 'bg';

    const { cols, rows, cellMeters: cm } = M;
    fine = new Float32Array(cols * rows); total = 0;
    for (const c of cells) { const n = sumSlots(c, 2); fine[c[1] * cols + c[0]] = n; total += n; }

    let share: number | null = null, unit = '';
    if (mode === 'bg') {
      await loadBgs();
      for (const b of bgs!) {
        b.n = sumSlots(b.counts, 0);
        b.v = state.measure === 'count' ? b.n : b.pop && b.pop >= bgMinPop ? (b.n / b.pop) * 1000 : null;
      }
      share = concentration(bgs!.map((b) => b.n!), bgs!.length);
      unit = 'block groups';
    } else {
      // Hexagons are built from the 150 m cells, so they honor every filter.
      const R = state.hexM / SQ3, map = new Map<string, { q: number; r: number; n: number }>();
      for (let i = 0; i < fine.length; i++) {
        if (!footprint[i]) continue;
        const [q, r] = toHex(((i % cols) + 0.5) * cm, (Math.floor(i / cols) + 0.5) * cm, R);
        const k = `${q},${r}`;
        const h = map.get(k) ?? map.set(k, { q, r, n: 0 }).get(k)!;
        h.n += fine[i];
      }
      hexes = [...map.values()];
      share = concentration(hexes.map((h) => h.n), hexes.length);
      unit = `${state.hexM >= 1000 ? state.hexM / 1000 + ' km' : state.hexM + ' m'} hexagons`;
    }
    $('[data-share]').textContent = share == null ? '–' : `${share.toFixed(1)}%`;
    $('[data-share-text]').textContent = total
      ? `of active ${unit} hold half of these ${total.toLocaleString()} incidents.`
      : 'No incidents match these filters.';
    sourceLine();
    draw();
  }

  // ── Drawing ────────────────────────────────────────────────
  const css = (v: string) => getComputedStyle(document.documentElement).getPropertyValue(v).trim();
  const ramp = () => [css('--ramp-1'), css('--ramp-2'), css('--ramp-3'), css('--ramp-4')];
  // Quantile class breaks on non-zero values: an analyst's default.
  function breaks(vals: number[]) {
    const nz = vals.filter((v) => v > 0).sort((a, b) => a - b);
    const q = (p: number) => nz[Math.min(nz.length - 1, Math.floor(p * nz.length))] ?? 0;
    return [q(0.5), q(0.8), q(0.95)];
  }
  const classOf = (v: number, b: number[]) => (v > b[2] ? 3 : v > b[1] ? 2 : v > b[0] ? 1 : 0);

  let W = 0, H = 0, sx = 1, sy = 1, mPerLon = 1;
  const project = (lon: number, lat: number) => [
    (lon - M.bbox[0]) * mPerLon * sx,
    H - (lat - M.bbox[1]) * 110540 * sy,
  ];

  function draw() {
    if (!M) return;
    const rect = canvas.getBoundingClientRect(), dpr = Math.min(devicePixelRatio || 1, 2);
    canvas.width = Math.round(rect.width * dpr); canvas.height = Math.round(rect.height * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    W = rect.width; H = rect.height;
    const { cols, rows, cellMeters: cm } = M;
    sx = W / (cols * cm); sy = H / (rows * cm);
    if (M.bbox) mPerLon = 111320 * Math.cos((((M.bbox[1] + M.bbox[3]) / 2) * Math.PI) / 180);
    const fx = W / cols, fy = H / rows, rp = ramp();
    ctx.clearRect(0, 0, W, H);

    // City footprint, faintly: every cell that ever had an incident.
    ctx.fillStyle = css('--paper-2');
    for (let i = 0; i < footprint.length; i++)
      if (footprint[i]) ctx.fillRect((i % cols) * fx, (rows - 1 - Math.floor(i / cols)) * fy, fx + 0.5, fy + 0.5);

    // River sits under the data so hot cells stay readable.
    if (base && M.bbox) strokeLines(base.river, css('--water'), 3.5, 0.45);

    if (mode === 'hex') {
      const R = state.hexM / SQ3, b = breaks(hexes.map((h) => h.n));
      ctx.strokeStyle = css('--rule'); ctx.lineWidth = 0.5;
      for (const h of hexes) {
        const [cx, cy] = hexCenter(h.q, h.r, R);
        ctx.beginPath();
        for (let k = 0; k < 6; k++) {
          const a = (Math.PI / 3) * k + Math.PI / 6;
          const px = (cx + R * Math.cos(a)) * sx, py = H - (cy + R * Math.sin(a)) * sy;
          k ? ctx.lineTo(px, py) : ctx.moveTo(px, py);
        }
        ctx.closePath();
        if (h.n > 0) {
          const c = classOf(h.n, b);
          ctx.fillStyle = rp[c]; ctx.globalAlpha = c === 0 ? 0.45 : 1; ctx.fill(); ctx.globalAlpha = 1;
        }
        ctx.stroke();
      }
    }

    if (mode === 'bg' && bgs) {
      const vals = bgs.map((g) => g.v ?? 0), b = breaks(vals);
      ctx.lineWidth = 0.6; ctx.strokeStyle = css('--card');
      for (const g of bgs) {
        const p = new Path2D();
        for (const ring of g.rings) {
          ring.forEach(([lon, lat], k) => { const [x, y] = project(lon, lat); k ? p.lineTo(x, y) : p.moveTo(x, y); });
          p.closePath();
        }
        g.path = p;
        if (g.v == null) { ctx.fillStyle = css('--rule'); ctx.globalAlpha = 0.6; }
        else if (g.v > 0) { const c = classOf(g.v, b); ctx.fillStyle = rp[c]; ctx.globalAlpha = c === 0 ? 0.5 : 0.95; }
        else { ctx.fillStyle = css('--paper-2'); ctx.globalAlpha = 1; }
        ctx.fill(p); ctx.globalAlpha = 1; ctx.stroke(p);
      }
    }

    if (mode === 'kde') {
      // Kernel density: spread each cell's count over its neighbors with
      // a Gaussian weight (bandwidth ≈ 3 cells ≈ 450 m).
      const bw = 3, R = bw * 3, dens = new Float32Array(cols * rows), kern: number[] = [];
      for (let dy = -R; dy <= R; dy++) for (let dx = -R; dx <= R; dx++) kern.push(Math.exp(-(dx * dx + dy * dy) / (2 * bw * bw)));
      for (let i = 0; i < fine.length; i++) {
        const n = fine[i]; if (!n) continue;
        const x0 = i % cols, y0 = Math.floor(i / cols); let t = 0;
        for (let dy = -R; dy <= R; dy++) for (let dx = -R; dx <= R; dx++, t++) {
          const x = x0 + dx, y = y0 + dy;
          if (x >= 0 && x < cols && y >= 0 && y < rows) dens[y * cols + x] += n * kern[t];
        }
      }
      let max = 0; for (const v of dens) max = Math.max(max, v);
      const off = document.createElement('canvas'); off.width = cols; off.height = rows;
      const o = off.getContext('2d')!;
      for (let i = 0; i < dens.length; i++) {
        const q = dens[i] / max; if (q < 0.06) continue;
        o.globalAlpha = Math.min(1, 0.25 + q * 1.1);
        o.fillStyle = q > 0.6 ? rp[3] : q > 0.35 ? rp[2] : q > 0.15 ? rp[1] : rp[0];
        o.fillRect(i % cols, rows - 1 - Math.floor(i / cols), 1, 1);
      }
      ctx.imageSmoothingEnabled = true; ctx.imageSmoothingQuality = 'high';
      ctx.drawImage(off, 0, 0, W, H);
    }

    if (mode === 'points') {
      // One dot per 150 m cell, sized by count: the raw pattern without
      // revealing any exact address.
      ctx.fillStyle = css('--hot'); ctx.globalAlpha = 0.7;
      const u = Math.max(1.2, Math.min(fx, fy) * 0.35);
      for (let i = 0; i < fine.length; i++) {
        const n = fine[i]; if (!n) continue;
        ctx.beginPath();
        ctx.arc((i % cols + 0.5) * fx, (rows - 1 - Math.floor(i / cols) + 0.5) * fy, Math.min(u * Math.sqrt(n), u * 5), 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1;
    }
    drawReference();
  }

  function strokeLines(lines: number[][][], color: string, width: number, alpha: number) {
    ctx.save(); ctx.strokeStyle = color; ctx.lineWidth = width; ctx.globalAlpha = alpha; ctx.lineJoin = 'round'; ctx.lineCap = 'round';
    for (const line of lines) {
      ctx.beginPath();
      line.forEach(([lon, lat], k) => { const [x, y] = project(lon, lat); k ? ctx.lineTo(x, y) : ctx.moveTo(x, y); });
      ctx.stroke();
    }
    ctx.restore();
  }

  // Roads and names go on top, thin and muted, as a reference layer.
  function drawReference() {
    if (!base || !M.bbox) return;
    const ink = css('--ink'), halo = css('--card');
    strokeLines(base.primary, ink, 0.6, 0.35);
    strokeLines(base.trunk, ink, 1, 0.45);
    strokeLines(base.motorway, halo, 3.2, 0.8);
    strokeLines(base.motorway, ink, 1.4, 0.7);
    ctx.save();
    ctx.font = `600 ${W < 420 ? 10 : 11}px ${css('--body')}`; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.lineWidth = 3; ctx.strokeStyle = halo; ctx.fillStyle = ink; ctx.lineJoin = 'round';
    for (const l of base.labels) {
      let [x, y] = project(l.lon, l.lat);
      if (x < 0 || x > W || y < 10 || y > H - 10) continue;
      const t = l.name.toUpperCase(), half = ctx.measureText(t).width / 2 + 4;
      x = Math.min(Math.max(x, half), W - half);   // keep the whole label inside the map
      ctx.strokeText(t, x, y); ctx.fillText(t, x, y);
    }
    ctx.restore();
  }

  // ── Interaction ────────────────────────────────────────────
  fig.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) =>
    b.addEventListener('click', () => {
      mode = b.dataset.mode as typeof mode;
      fig.querySelectorAll('[data-mode]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      recompute();
    }),
  );

  const hover = $<HTMLElement>('[data-hover]');
  canvas.addEventListener('pointermove', (e) => {
    if (!M) return;
    const r = canvas.getBoundingClientRect(), x = e.clientX - r.left, y = e.clientY - r.top;
    let text = '';
    if (mode === 'bg' && bgs) {
      const g = bgs.find((g) => g.path && ctx.isPointInPath(g.path, x * (canvas.width / W), y * (canvas.height / H)));
      if (g) {
        const pop = g.pop == null ? 'population unknown' : `${g.pop.toLocaleString()} residents`;
        const rate = g.pop && g.pop >= bgMinPop ? ` · ${((g.n! / g.pop) * 1000).toFixed(1)} per 1,000` : g.pop != null ? ' · too few residents for a rate' : '';
        text = `Block group ${g.id} · ${g.n!.toLocaleString()} incidents · ${pop}${rate}`;
      }
    } else if (mode === 'hex') {
      const [q, rr] = toHex(x / sx, (H - y) / sy, state.hexM / SQ3);
      const h = hexes.find((h) => h.q === q && h.r === rr);
      if (h) text = `${h.n.toLocaleString()} incident${h.n === 1 ? '' : 's'} in this hexagon`;
    }
    hover.textContent = text; hover.hidden = !text;
  });
  canvas.addEventListener('pointerleave', () => (hover.hidden = true));

  new ResizeObserver(draw).observe(canvas);
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', draw);
  new MutationObserver(draw).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
</script>
