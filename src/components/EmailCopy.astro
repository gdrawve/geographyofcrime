---
// Shows the email as plain, selectable text with a Copy button.
// No contact form: forms on static sites need a third-party
// service, and a visible address is simpler and spam-filtered by
// your inbox anyway.
import { site } from '../data/site';
---
<div class="email">
  <p class="label">Email</p>
  <div class="email-row">
    <a href={`mailto:${site.email}`} class="addr">{site.email}</a>
    <button type="button" class="copy" data-copy={site.email}>Copy</button>
  </div>
</div>

<style>
  .email { display: grid; gap: 0.5rem; min-width: 0; }
  .email-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; }
  .addr { font-family: var(--mono); font-size: clamp(0.95rem, 0.8rem + 0.6vw, 1.15rem); word-break: break-all; }
  .copy {
    font: 500 var(--t-xs)/1 var(--mono); letter-spacing: 0.06em; text-transform: uppercase;
    padding: 0.55rem 0.8rem; border: 1.5px solid var(--ink); border-radius: var(--radius);
    background: transparent; color: var(--ink); cursor: pointer;
  }
  .copy:hover { background: var(--ink); color: var(--paper); }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) =>
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copy!);
        b.textContent = 'Copied';
      } catch {
        // Clipboard blocked: select the address so it can be copied by hand.
        const a = b.previousElementSibling!;
        const r = document.createRange(); r.selectNodeContents(a);
        const s = getSelection()!; s.removeAllRanges(); s.addRange(r);
        b.textContent = 'Selected';
      }
      setTimeout(() => (b.textContent = 'Copy'), 1800);
    }),
  );
</script>
