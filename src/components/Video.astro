---
// A fast, private YouTube slot: a thumbnail served from this site and a
// play button. The YouTube player (~1 MB) loads only when someone
// presses play, and nothing contacts YouTube before that.
// Behavior lives in src/scripts/yt.ts.
interface Props { id: string; title: string; }
const { id, title } = Astro.props;
---
<div class="yt">
  <a class="yt-btn" href={`https://www.youtube.com/watch?v=${id}`} data-yt={id} data-title={title} aria-label={`Play: ${title}`}>
    <img src={`/yt/${id}.jpg`} alt="" width="480" height="360" loading="lazy" />
    <span class="yt-play" aria-hidden="true"></span>
  </a>
</div>

<script>
  import '../scripts/yt';
</script>
