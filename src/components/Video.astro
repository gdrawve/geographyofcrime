---
// A fast YouTube slot. It shows only a thumbnail and a play button
// until someone taps it; the full YouTube player (~1 MB) loads on
// demand. The old site loaded every player up front, which is why
// its tutorial pages were slow.
import 'lite-youtube-embed/src/lite-yt-embed.css';

interface Props { id: string; title: string; }
const { id, title } = Astro.props;
---
<lite-youtube videoid={id} playlabel={`Play: ${title}`} params="rel=0" title={title}>
  <a href={`https://www.youtube.com/watch?v=${id}`} class="lty-playbtn" title={`Play: ${title}`}>
    <span class="lyt-visually-hidden">Play: {title}</span>
  </a>
</lite-youtube>

<script>
  // Registers the <lite-youtube> element once per page.
  import 'lite-youtube-embed/src/lite-yt-embed.js';
</script>
