---
// The frame every page sits in: <head> tags, header, footer, and
// the schema.org identity block that tells search engines and AI
// tools who runs this site.
import '../styles/global.css';
import { site, person, nav } from '../data/site';

interface Props {
  title?: string;            // page name; site name is appended
  description?: string;
  schema?: object | object[]; // extra JSON-LD for this page
  wide?: boolean;
}
const { title, description = site.description, schema } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · Grant Drawve`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const path = Astro.url.pathname;

// The "who" block, present on every page. sameAs links the
// profiles together into one identity.
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${site.url}/#grant-drawve`,
  name: person.name,
  honorificSuffix: person.honorific,
  image: `${site.url}/brand/headshot.jpg`,
  jobTitle: person.jobTitle,
  worksFor: { '@type': 'Organization', name: person.employer.name, url: person.employer.url },
  alumniOf: person.education.map((e) => ({ '@type': 'CollegeOrUniversity', name: e.school })),
  knowsAbout: person.knowsAbout,
  homeLocation: { '@type': 'Place', name: site.location },
  url: site.url,
  sameAs: person.profiles.map((p) => p.url),
};
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  name: site.name,
  url: site.url,
  description: site.description,
  author: { '@id': `${site.url}/#grant-drawve` },
};
const extra = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const ld = [personLd, websiteLd, ...extra];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="claude:viewport-fit-sides" content="cover" />
    <meta name="description" content={description} />
    <meta name="author" content="Grant Drawve" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#1f2d48" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site.url}/brand/og.png`} />
    <meta property="og:image:alt" content="Geography of Crime badge: a magnifying glass over a city map" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="The Geography of Crime podcast" href="/podcast/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,500..900&family=Cinzel:wght@600&family=IBM+Plex+Mono:wght@400;500&family=Public+Sans:ital,wght@0,400..700;1,400&display=swap"
    />

    {ld.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
  </head>
  <body>
    <a class="skip visually-hidden" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a href="/" class="brand" aria-label="Geography of Crime, home">
          <img class="mark" src="/favicon.svg" alt="" width="30" height="30" />
          <span class="brand-name">Geography of Crime</span>
        </a>
        <nav aria-label="Main">
          <ul>
            {nav.map((n) => (
              <li><a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
            ))}
            <li><a href="/search/" class="search-link" aria-label="Search the site">
              <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12.8 12.8 17.5 17.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
              <span>Search</span>
            </a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" data-pagefind-body>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap foot">
        <div class="foot-id">
          <img class="foot-badge" src="/brand/badge-160.webp" alt="" width="80" height="80" loading="lazy" />
        <div class="stack">
          <p class="label">{site.coords} · {site.location}</p>
          <p class="foot-line">Grant Drawve, PhD. Spatial criminologist and host of <em>The Geography of Crime</em>.</p>
          <p class="foot-line">This is a personal site. Views are my own and do not represent CAP Index.</p>
        </div>
        </div>
        <nav class="foot-cols" aria-label="Footer">
          <div>
            <p class="label">Research</p>
            <ul>
              {person.profiles.filter((p) => /Scholar|ResearchGate|ORCID|LinkedIn/.test(p.label)).map((p) => <li><a href={p.url} rel="me noopener" target="_blank">{p.label}</a></li>)}
            </ul>
          </div>
          <div>
            <p class="label">Watch &amp; listen</p>
            <ul>
              {person.profiles.filter((p) => /YouTube/.test(p.label)).map((p) => <li><a href={p.url} rel="me noopener" target="_blank">{p.label.replace(' (YouTube)', '')}</a></li>)}
              <li><a href="/podcast/rss.xml">Podcast RSS</a></li>
            </ul>
          </div>
          <div>
            <p class="label">Site</p>
            <ul>
              <li><a href="/about/">About</a></li>
              <li><a href="/privacy/">Privacy</a></li>
              <li><a href="/accessibility/">Accessibility</a></li>
            </ul>
          </div>
        </nav>
        <p class="label foot-copy">© {new Date().getFullYear()} Grant Drawve</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip:focus { position: fixed; top: 8px; left: 8px; width: auto; height: auto; clip: auto; background: var(--ink); color: var(--paper); padding: 0.5rem 0.8rem; z-index: 50; }

  .site-header {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 20;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--rule);
  }
  :global(body::before) {
    content: '';
    position: fixed;
    inset: 0 0 auto;
    height: env(safe-area-inset-top, 0px);
    z-index: 21;
    background: var(--paper);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.75rem;
    flex-wrap: wrap;
  }
  .brand { display: inline-flex; align-items: center; gap: 0.6rem; text-decoration: none; color: var(--ink); }
  .mark { width: 30px; height: 30px; flex: none; }
  .brand-name {
    font-family: var(--mark);
    font-weight: 600;
    font-size: 1.02rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  nav ul { display: flex; flex-wrap: wrap; gap: 0.15rem 1.25rem; list-style: none; margin: 0; padding: 0; }
  nav a {
    display: inline-flex; align-items: center; gap: 0.35rem;
    text-decoration: none;
    font-size: var(--t-sm);
    font-weight: 500;
    padding-block: 0.4rem;
    border-bottom: 2px solid transparent;
  }
  nav a[aria-current='page'] { border-bottom-color: var(--hot); }
  nav a:hover { color: var(--hot-ink); }

  @media (max-width: 640px) {
    .bar { padding-block: 0.6rem; }
    nav { width: 100%; overflow-x: auto; }
    nav ul { flex-wrap: nowrap; gap: 1.1rem; }
    nav a { white-space: nowrap; }
    .search-link span { display: none; }
  }

  .site-footer { border-top: 1px solid var(--rule); background: var(--paper-2); }
  .foot {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: minmax(0, 1fr);
    padding-block: 2.5rem 2rem;
  }
  @media (min-width: 760px) { .foot { grid-template-columns: minmax(0, 1fr) auto; } }
  .foot-id { display: flex; gap: 1rem; align-items: center; min-width: 0; }
  .foot-badge { width: 80px; height: 80px; flex: none; }
  .foot-line { color: var(--ink-2); font-size: var(--t-sm); }
  .foot-cols { display: grid; grid-template-columns: repeat(3, minmax(0, max-content)); gap: 1.25rem 2.5rem; align-content: start; }
  @media (max-width: 520px) { .foot-cols { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .foot-cols ul { list-style: none; margin: 0.45rem 0 0; padding: 0; display: grid; gap: 0.35rem; font-size: var(--t-sm); }
  .foot-copy { grid-column: 1 / -1; }
</style>
