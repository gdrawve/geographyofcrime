---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="section">
    <div class="wrap stack">
      <p class="label">Error 404 · <span class="hot">No incidents at this address</span></p>
      <h1>This page isn't on the map.</h1>
      <p class="lede">It may have moved when the site was rebuilt. Try the <a href="/podcast/">podcast</a>, the <a href="/tutorials/">tutorials</a>, or <a href="/search/">search</a>.</p>
    </div>
  </section>
</Base>
