---
import Base from '../layouts/Base.astro';
import EmailCopy from '../components/EmailCopy.astro';
import NwaMap from '../components/NwaMap.astro';
import { person } from '../data/site';

// Career timeline, newest first. Edit here when roles change.
const career = [
  {
    years: '2023 – now',
    role: 'Vice President of Geospatial Crime Solutions',
    org: 'CAP Index · Research & Innovation',
    note: 'Hired to build the Research & Innovation division. Brought four new products to market, leads a team of crime and data analysts, and partners with RILA on its Vibrant Communities Initiative.',
  },
  {
    years: '2016 – 2023',
    role: 'Assistant, then Associate Professor',
    org: 'University of Arkansas · Sociology & Criminology',
    note: 'Taught spatial analysis, research methods, and criminological theory. Fulbright College Master Researcher Award, 2019.',
  },
  {
    years: '2020 – 2023',
    role: 'Associate Director, Crime & Security Data Analytics Lab (CASDAL)',
    org: 'Terrorism Research Center, University of Arkansas',
    note: 'Applied crime analytics with police agencies, school districts, and public-health partners.',
  },
  {
    years: '2015 – 2016',
    role: 'Post-Doctoral Research Associate',
    org: 'Rutgers University · School of Criminal Justice and Department of Psychology',
    note: 'Risk terrain modeling and risk-based policing with the Rutgers Center on Public Security.',
  },
];

// Places around Northwest Arkansas, for the "Home base" panel.
const nwaPlaces = [
  { city: 'Bentonville', places: [
    ['Downtown Square', 'Local shops · community gatherings'],
    ['Crystal Bridges', 'Museum grounds · woodland trails'],
    ['Coler Mountain Bike Preserve', 'Mountain biking · outdoor recreation'],
  ] },
  { city: 'Rogers', places: [
    ['Historic Downtown', 'Walkable streets · local businesses'],
    ['Pinnacle Hills Promenade', 'Regional shopping · dining'],
    ['Lake Atalanta', 'Lakeside park · connected trails'],
  ] },
  { city: 'Springdale', places: [
    ['Downtown / Emma Avenue', 'Arts · public spaces · Greenway'],
    ['Arvest Ballpark', 'Baseball · event-day destinations'],
    ['Jones Center', 'Sports · community recreation'],
  ] },
  { city: 'Fayetteville', places: [
    ['University of Arkansas', 'Campus · learning · gathering places'],
    ['Dickson Street', 'Dining · live music · nightlife'],
    ['Kessler Mountain Regional Park', 'Trails · sports fields · open space'],
  ] },
];

// Selected highlights from the CV.
const highlights = [
  { figure: '$2.7M', label: 'External funding as PI or Co-PI', detail: 'NIJ, NSF, BJA, DHS, and OJJDP, plus city and nonprofit partners' },
  { figure: '2017', label: 'NIJ Real-Time Crime Forecasting Challenge', detail: 'Selected winner, with Caplan, Kennedy, and Piza' },
  { figure: 'IACP', label: 'Leadership in Law Enforcement Research Award', detail: 'Earned by Kansas City PD for the risk-based policing experiment' },
  { figure: 'Nat Geo', label: 'Breakthrough, season 2', detail: 'Featured: Atlantic City risk-based policing project' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: { '@id': 'https://geographyofcrime.com/#grant-drawve' },
};
---
<Base
  title="About"
  description="Grant Drawve, PhD, is Vice President of Geospatial Crime Solutions at CAP Index, where he built the Research & Innovation division, and a former associate professor of criminology at the University of Arkansas. He studies how place shapes crime and public safety."
  schema={schema}
>
  <section class="section">
    <div class="wrap about">
      <header class="about-head">
        <img class="headshot" src="/brand/headshot-face-400.webp" alt="Grant Drawve, smiling, in glasses and a plaid jacket" width="200" height="200" />
        <div class="stack">
        <p class="label">About</p>
        <h1>Grant Drawve, PhD</h1>
        <p class="lede">I study how place shapes crime and public safety, and I try to make that research usable by the people who work on it every day.</p>
        </div>
      </header>

      <div class="bio stack">
        <p>
          I'm {person.jobTitle} at <a href={person.employer.url} target="_blank" rel="noopener">CAP Index</a>,
          a crime risk scoring and modeling company. You can learn more about CAP's work on the
          <a href={person.employer.url} target="_blank" rel="noopener">CAP Index website</a>.
        </p>
        <p>
          Day to day, I lead a team of crime and data analysts hunting data, standardizing the messiness,
          and developing pipelines. I am also CAP's research partner to the Retail Industry Leaders
          Association on its Vibrant Communities Initiative in Atlantic City, NJ and Clackamas County, OR,
          and I speak regularly to retail, security, and loss-prevention audiences.
        </p>
        <p>
          Before CAP, I spent seven years on the faculty of the University of Arkansas, where I was associate
          director of the Crime &amp; Security Data Analytics Lab and worked with police departments on why some
          places carry far more crime than others. The podcast, tutorials, and talks here come from the same
          goal: translate geographic, data, and technology insights into strategies people can use.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><h2>Career</h2></div>
      <ol class="timeline">
        {career.map((c) => (
          <li>
            <p class="label years">{c.years}</p>
            <div class="stack tl-body">
              <h3>{c.role}</h3>
              <p class="org">{c.org}</p>
              <p class="note">{c.note}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><h2>Highlights</h2></div>
      <ul class="hl">
        {highlights.map((h) => (
          <li>
            <span class="hl-fig">{h.figure}</span>
            <span class="hl-label">{h.label}</span>
            <span class="hl-detail">{h.detail}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap two">
      <div class="stack">
        <h2>Education</h2>
        <p>Publications, grants, teaching, and service are in my CV.</p>
        <dl class="facts">
          {person.education.map((e) => (
            <div><dt class="label">{e.degree.split(',')[0]}</dt><dd>{e.degree.split(', ')[1]}<br /><span class="muted">{e.school}</span></dd></div>
          ))}
        </dl>
        <p><a class="btn" href={person.cv} target="_blank" rel="noopener">Download CV (PDF)</a></p>
      </div>
      <div class="stack">
        <h2>Research and profiles</h2>
        <p>A summary of the research is on the <a href="/research/">Research</a> page.</p>
        <ul class="links">
          {person.profiles.map((p) => (
            <li><a href={p.url} target="_blank" rel="me noopener"><span>{p.label}</span><span aria-hidden="true">↗</span></a></li>
          ))}
          <li><a href="https://www.youtube.com/@crimewithgrant" target="_blank" rel="noopener"><span>Crime with Grant (archive channel)</span><span aria-hidden="true">↗</span></a></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Outside of work</h2>
      </div>
      <!-- Three panels that share one card style: Lego and family on
           top, then the dogs with their photos as the wide panel. -->
      <div class="life">
        <article class="panel lego-panel">
          <img class="lego" src="/brand/lego-bigfoot-480.webp" alt="Grant's Lego-style profile picture: a bearded bigfoot minifigure in glasses holding a crime analytics report" width="240" height="240" loading="lazy" />
          <div class="stack">
            <p class="label">Lego</p>
            <p>I own more Lego sets than I'd like to admit. They were easier to hide in a campus office than at home. Star Wars makes up most of the collection; the current build is the Batmobile.</p>
          </div>
        </article>

        <article class="panel family-panel">
          <p class="label">Family</p>
          <p class="big-line">Five of us.</p>
          <p>When we're not running between sports and activities, we're usually outside: hiking, biking, landscaping, or making the most of patio season.</p>
        </article>

        <!-- Home base: the NWA map with a callout card for each city, joined
             to its dot by a leader line. Hovering or focusing a card (or a
             dot) highlights the pair. Lines are drawn by the script below. -->
        <article class="panel home-panel" data-nwa>
          <header class="stack home-head">
            <p class="label">Home base</p>
            <p class="big-line">Northwest Arkansas.</p>
            <p>We live along the I-49 corridor that ties Bentonville, Rogers, Springdale, and Fayetteville together. One region, many places: connected by corridors, defined by neighborhoods.</p>
          </header>
          <div class="nwa-stage">
            <svg class="leaders" aria-hidden="true"></svg>
            {[[0, 2], [1, 3]].map((idx, side) => (
              <div class:list={['nwa-col', side === 0 ? 'left' : 'right']}>
                {idx.map((i) => {
                  const c = nwaPlaces[i];
                  return (
                    <section class="nwa-card" data-city={c.city} style={`--n: ${i + 1}`} tabindex="0" aria-label={`${c.city}: ${c.places.map((p) => p[0]).join(', ')}`}>
                      <p class="label nwa-n">{String(i + 1).padStart(2, '0')} / Different places within</p>
                      <h3>{c.city}</h3>
                      <ul>
                        {c.places.map(([name, what]) => <li><strong>{name}</strong><span>{what}</span></li>)}
                      </ul>
                    </section>
                  );
                })}
              </div>
            ))}
            <div class="nwa-col mid"><NwaMap /></div>
          </div>
        </article>

        <article class="panel dogs-panel">
          <div class="stack dogs-text">
            <p class="label">The dogs, shortest to tallest</p>
            <ol class="dogs">
              <li><strong>Dorothy</strong> <span>super-mutt</span></li>
              <li><strong>Basil</strong> <span>beagle mix</span></li>
              <li><strong>Gambit</strong> <span>laika</span></li>
            </ol>
          </div>
          <figure>
            <img src="/brand/dogs-basil-dorothy-960.webp" srcset="/brand/dogs-basil-dorothy-480.webp 480w, /brand/dogs-basil-dorothy-960.webp 960w" sizes="(min-width: 900px) 30vw, 100vw" alt="Basil, a black-and-white beagle mix, and Dorothy, a small scruffy grey mutt, curled up in dog beds in their built-in nook" width="960" height="720" loading="lazy" />
            <figcaption class="label">Basil and Dorothy, off duty</figcaption>
          </figure>
          <figure>
            <img src="/brand/dog-gambit-960.webp" srcset="/brand/dog-gambit-480.webp 480w, /brand/dog-gambit-960.webp 960w" sizes="(min-width: 900px) 30vw, 100vw" alt="Gambit, a grey-and-white laika, sitting on a gravel bank beside a tree-lined river" width="960" height="720" loading="lazy" />
            <figcaption class="label">Gambit, scouting the river</figcaption>
          </figure>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <EmailCopy />
    </div>
  </section>
</Base>

<style>
  .about-head { display: grid; gap: 1.25rem 2rem; grid-template-columns: minmax(0, 1fr); align-items: center; }
  @media (min-width: 640px) { .about-head { grid-template-columns: 200px minmax(0, 1fr); } }
  .headshot { width: 200px; height: 200px; border-radius: 50%; object-fit: cover; border: 3px solid var(--card); box-shadow: 0 0 0 1px var(--rule); }
  .lego { width: 140px; height: 140px; border-radius: var(--radius); border: 1px solid var(--rule); }
  .about { display: grid; gap: 2.5rem; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 900px) { .about { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: end; } }
  .bio p { max-width: 62ch; }

  .timeline { list-style: none; margin: 0; padding: 0; border-top: 1.5px solid var(--ink); }
  .timeline li { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.4rem 2rem; padding: 1.25rem 0; border-bottom: 1px solid var(--rule); }
  @media (min-width: 760px) { .timeline li { grid-template-columns: 9rem minmax(0, 1fr); } }
  .years { color: var(--hot-ink); padding-top: 0.25rem; }
  .tl-body { gap: 0.3rem; }
  .tl-body h3 { font-size: var(--t-lg); }
  .org { font-weight: 500; }
  .note { color: var(--ink-2); font-size: var(--t-sm); }

  .hl { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); border-top: 1.5px solid var(--ink); }
  .hl li { display: grid; gap: 0.3rem; align-content: start; padding: 1.2rem 1.25rem 1.4rem 0; border-bottom: 1px solid var(--rule); }
  .hl-fig { font-family: var(--display); font-stretch: 125%; font-weight: 850; font-size: 2.4rem; line-height: 1; color: var(--hot-ink); }
  .hl-label { font-weight: 650; }
  .hl-detail { color: var(--ink-2); font-size: var(--t-sm); }

  .two { display: grid; gap: 2.5rem 3rem; grid-template-columns: minmax(0, 1fr); }
  /* Pack each column from the top; otherwise the shorter column stretches
     to match the taller one and its gaps grow, knocking the rules out of line. */
  .two > .stack { align-content: start; }
  @media (min-width: 860px) { .two { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }
  .facts { margin: 0; display: grid; border-top: 1.5px solid var(--ink); align-content: start; }
  .facts div { display: grid; grid-template-columns: 4rem minmax(0, 1fr); gap: 1rem; padding: 0.85rem 0; border-bottom: 1px solid var(--rule); }
  .facts dd { margin: 0; }
  .muted { color: var(--ink-2); font-size: var(--t-sm); }
  .links { list-style: none; margin: 0; padding: 0; border-top: 1.5px solid var(--ink); }
  .links a { display: flex; justify-content: space-between; gap: 1rem; padding: 0.85rem 0.25rem; border-bottom: 1px solid var(--rule); text-decoration: none; font-weight: 500; }
  .links a:hover { background: var(--paper-2); }
  /* Outside of work: one card style for all three panels. */
  .life { display: grid; gap: 1.25rem; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 860px) { .life { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); } }
  .panel { background: var(--card); border: 1px solid var(--rule); border-radius: var(--radius); padding: 1.25rem; display: grid; gap: 0.6rem; align-content: start; min-width: 0; }
  .lego-panel { grid-template-columns: 120px minmax(0, 1fr); gap: 1.1rem; align-items: start; }
  @media (max-width: 420px) { .lego-panel { grid-template-columns: minmax(0, 1fr); } }
  .lego { width: 120px; height: 120px; border-radius: var(--radius); border: 1px solid var(--rule); background: var(--paper); }
  .big-line { font-family: var(--display); font-stretch: 125%; font-weight: 850; font-size: 2rem; line-height: 1; color: var(--hot-ink); }
  /* Home base: cards | map | cards on wide screens, with leader lines;
     on smaller screens the map comes first and the cards sit below it. */
  .home-panel { grid-column: 1 / -1; gap: 1.25rem; }
  .home-head p:last-child { max-width: 60ch; }
  /* Small screens: the side columns dissolve so the cards flow in
     01–04 order under the map. */
  .nwa-stage { position: relative; display: grid; gap: 1rem; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 600px) { .nwa-stage { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .nwa-col.left, .nwa-col.right { display: contents; }
  .nwa-card { order: var(--n); }
  .nwa-col.mid { order: 0; grid-column: 1 / -1; max-width: 26rem; justify-self: center; width: 100%; }
  .leaders { display: none; }
  @media (min-width: 1180px) {
    .nwa-stage { grid-template-columns: minmax(0, 1fr) minmax(18rem, 25rem) minmax(0, 1fr); align-items: stretch; gap: 2.5rem; }
    .nwa-col.left, .nwa-col.right { display: grid; gap: 1rem; grid-template-columns: minmax(0, 1fr); align-content: space-around; position: relative; z-index: 1; }
    .nwa-card { order: 0; }
    .nwa-col.left { grid-column: 1; }
    .nwa-col.mid { order: 0; grid-column: 2; grid-row: 1; max-width: none; justify-self: stretch; }
    .nwa-col.right { grid-column: 3; grid-row: 1; }
    .leaders { display: block; position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; overflow: visible; }
  }
  .leaders :global(path) { fill: none; stroke: var(--hot); stroke-width: 1.25; opacity: 0.55; transition: opacity 0.15s, stroke-width 0.15s; }
  .leaders :global(path.on) { opacity: 1; stroke-width: 2; }
  .nwa-card { background: var(--paper); border: 1px solid var(--rule); border-top: 3px solid var(--hot); border-radius: var(--radius); padding: 0.9rem 1rem 1rem; display: grid; gap: 0.5rem; align-content: start; transition: box-shadow 0.15s, transform 0.15s; outline: none; }
  .nwa-card.on, .nwa-card:focus-visible { box-shadow: 0 8px 22px rgba(31, 45, 72, 0.14); transform: translateY(-2px); }
  .nwa-card:focus-visible { outline: 2px solid var(--hot); outline-offset: 2px; }
  .nwa-card h3 { font-size: clamp(1.5rem, 1.1rem + 1vw, 2rem); overflow-wrap: anywhere; }
  .nwa-n { color: var(--hot-ink); }
  .nwa-card ul { list-style: none; margin: 0; padding: 0; display: grid; }
  .nwa-card ul li { display: grid; gap: 0.05rem; padding: 0.45rem 0; border-top: 1px solid var(--rule); font-size: var(--t-sm); }
  .nwa-card ul li:first-child { border-top: 0; padding-top: 0; }
  .nwa-card ul li span { color: var(--ink-2); font-size: var(--t-xs); }
  /* Highlighted city on the map */
  .home-panel :global(.town .halo) { transition: opacity 0.15s; }
  .home-panel :global(.town.on .halo) { opacity: 0.4; }
  .home-panel :global(.town.on text) { fill: var(--hot-ink); }
  .home-panel :global(.town) { cursor: pointer; }
  .dogs-panel { grid-column: 1 / -1; grid-template-columns: minmax(0, 1fr); gap: 1.1rem; }
  @media (min-width: 760px) { .dogs-panel { grid-template-columns: 13rem minmax(0, 1fr) minmax(0, 1fr); align-items: start; } }
  .dogs-panel figure { margin: 0; display: grid; gap: 0.45rem; min-width: 0; }
  .dogs-panel img { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius); display: block; }
  .dogs { margin: 0; padding: 0; list-style: none; display: grid; gap: 0.55rem; }
  .dogs li { display: grid; gap: 0.05rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--rule); }
  .dogs li:last-child { border-bottom: 0; }
  .dogs span { color: var(--ink-2); font-size: var(--t-sm); }
</style>

<script>
  // Leader lines from each callout card to its city dot, plus the shared
  // hover/focus highlight. Redrawn whenever the layout changes size.
  const panel = document.querySelector<HTMLElement>('[data-nwa]');
  if (panel) {
    const stage = panel.querySelector<HTMLElement>('.nwa-stage')!;
    const svg = panel.querySelector<SVGSVGElement>('.leaders')!;
    const cards = [...panel.querySelectorAll<HTMLElement>('.nwa-card')];
    const town = (city: string) => panel.querySelector<SVGGElement>(`.town[data-city="${city}"]`);
    const NS = 'http://www.w3.org/2000/svg';

    function draw() {
      svg.replaceChildren();
      if (getComputedStyle(svg).display === 'none') return;
      const s = stage.getBoundingClientRect();
      for (const card of cards) {
        const dot = town(card.dataset.city!)?.querySelector('.dot');
        if (!dot) continue;
        const c = card.getBoundingClientRect(), d = dot.getBoundingClientRect();
        const left = card.closest('.left') !== null;
        const x1 = (left ? c.right : c.left) - s.left, y1 = c.top + 46 - s.top;   // level with the city name
        const x2 = d.left + d.width / 2 - s.left, y2 = d.top + d.height / 2 - s.top;
        const bend = left ? Math.min(x1 + 28, x2) : Math.max(x1 - 28, x2);
        // Out from the card, then straight to the dot.
        const path = document.createElementNS(NS, 'path');
        path.setAttribute('d', `M${x1},${y1} L${bend},${y1} L${x2},${y2}`);
        path.dataset.city = card.dataset.city!;
        svg.append(path);
      }
    }
    function highlight(city: string | null) {
      cards.forEach((c) => c.classList.toggle('on', c.dataset.city === city));
      panel!.querySelectorAll('.town').forEach((t) => t.classList.toggle('on', (t as SVGGElement).dataset.city === city));
      svg.querySelectorAll('path').forEach((p) => p.classList.toggle('on', p.dataset.city === city));
    }
    cards.forEach((c) => {
      c.addEventListener('pointerenter', () => highlight(c.dataset.city!));
      c.addEventListener('pointerleave', () => highlight(null));
      c.addEventListener('focus', () => highlight(c.dataset.city!));
      c.addEventListener('blur', () => highlight(null));
    });
    panel.querySelectorAll<SVGGElement>('.town').forEach((t) => {
      t.addEventListener('pointerenter', () => highlight(t.dataset.city!));
      t.addEventListener('pointerleave', () => highlight(null));
      // Tapping a city on the map brings its card into view.
      t.addEventListener('click', () => cards.find((c) => c.dataset.city === t.dataset.city)?.scrollIntoView({ behavior: 'smooth', block: 'nearest' }));
    });
    new ResizeObserver(draw).observe(stage);
    document.fonts?.ready.then(draw);
    draw();
  }
</script>
